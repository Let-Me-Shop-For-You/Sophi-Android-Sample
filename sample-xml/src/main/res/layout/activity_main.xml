<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/home_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/home_description" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_start" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_start_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_start_message" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_start_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_start_product" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_embedded"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/action_embedded" />

</LinearLayout>
